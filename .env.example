# Application
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# MongoDB — replace with your connection string
MONGODB_URI=mongodb://127.0.0.1:27017/ssbpsychbigb

# CORS — comma-separated origins allowed to call the API
# Include admin subdomain origin when using admin.localhost
CORS_ORIGIN=http://localhost:5173,http://admin.localhost:5173

# Node-only DNS (does not change Windows DNS). Leave empty to use OS defaults.
DNS_SERVERS=8.8.8.8,1.1.1.1

# Auth — MUST change JWT_SECRET in production
JWT_SECRET=YOUR_JWT_SECRET
JWT_EXPIRES_IN=7d
OTP_LENGTH=6
OTP_TTL_SECONDS=300
# true until SMS gateway is live — API returns OTP for on-screen entry
OTP_EXPOSE_IN_RESPONSE=true
UPLOAD_DIR=uploads
UPLOAD_MAX_BYTES=5242880

# Transactional email (Nodemailer SMTP)
# Local safe testing: use Mailtrap SMTP and set EMAIL_ENABLED=true
# Gmail: use an App Password, never your real account password
EMAIL_ENABLED=false
EMAIL_FROM="BIGB <noreply@example.com>"
APP_PUBLIC_URL=http://localhost:5173
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Feature flags
# Public Freelancer Educator register (Join as Educator). Default true.
EDUCATOR_FREELANCER_REGISTER=true

# Super Admin seed (yarn seed:admin)
SUPER_ADMIN_LOGIN_ID=superadmin
SUPER_ADMIN_PASSWORD=bigb@super123!
SUPER_ADMIN_EMAIL=superadmin@bigb.io
SUPER_ADMIN_NAME=BIGB Super Admin

# Web Push (VAPID) — Wave 5. Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@bigb.app
