# Application
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# MongoDB — replace with your connection string
MONGODB_URI=mongodb+srv://ssbpsychbigb_db_user:68SuyMmlceSB3ZiS@cluster0.5qloafh.mongodb.net/ssbpsychbigb

# CORS — comma-separated origins allowed to call the API
CORS_ORIGIN=http://localhost:5173,http://admin.localhost:5173

# Node-only DNS (does not change Windows DNS). Leave empty to use OS defaults.
DNS_SERVERS=8.8.8.8,1.1.1.1

# Auth — replace JWT_SECRET before any real deployment
JWT_SECRET=dev-only-change-me-ssbpsychbigb-jwt-secret
JWT_EXPIRES_IN=7d
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_EXPOSE_IN_RESPONSE=true
UPLOAD_DIR=uploads
UPLOAD_MAX_BYTES=5242880
# Feed video MVP (5 min / 250 MB)
FEED_VIDEO_MAX_BYTES=262144000

# Super Admin seed (yarn seed:admin) — change before production
SUPER_ADMIN_LOGIN_ID=superadmin
SUPER_ADMIN_PASSWORD=bigb@123!
SUPER_ADMIN_EMAIL=superadmin@bigb.io
SUPER_ADMIN_NAME=BIGB Super Admin

